{
  "name": "liujie-defense",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "界域净化 —— 域卫防守 PvE 游戏",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "selftest": "tsx scripts/simtest.ts",
    "package:itch": "node scripts/package-itch.mjs",
    "dev:lan": "vite --host 0.0.0.0",
    "serve": "vite preview --host 0.0.0.0 --port 4173",
    "server": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^5.0.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "tsx": "^4.23.15",
    "ws": "^8.22.2"
  },
  "engines": {
    "node": ">=20"
  }
}
